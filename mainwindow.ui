  <property name="styleSheet">
   <string notr="true">/* ===== MAIN WINDOW ===== */
QMainWindow {
    background-color: #f2f2f2;   /* Light grey */
}

/* ===== LABELS ===== */
QLabel {
    color: #333;
    font-size: 13px;
    font-weight: 500;
}

/* ===== LINE EDIT ===== */
QLineEdit {
    background-color: white;
    color: black;
    padding: 6px;
    border-radius: 6px;
    border: 1px solid #bfbfbf;
}

/* ===== DATE EDIT ===== */
QDateEdit {
    background-color: white;
    color: black;
    padding: 6px;
    border-radius: 6px;
    border: 1px solid #bfbfbf;
}

/* ===== COMBOBOX ===== */
QComboBox {
    background-color: white;
    color: black;
    padding: 6px;
    border-radius: 6px;
    border: 1px solid #bfbfbf;
}

/* Dropdown list */
QComboBox QAbstractItemView {
    background-color: white;
    selection-background-color: #4da3ff;
    selection-color: white;
}

/* ===== TABLE ===== */
QTableWidget {
    background-color: white;
    alternate-background-color: #f7f7f7;
    gridline-color: #d9d9d9;
    font-size: 12px;
    border: 1px solid #cfcfcf;
}

/* ===== TABLE HEADER ===== */
QHeaderView::section {
    background-color: #e6e6e6;
    padding: 5px;
    border: 1px solid #cfcfcf;
    font-weight: bold;
}

/* ===== BUTTON ===== */
QPushButton {
    background-color: #4da3ff;
    color: white;
    padding: 7px 16px;
    border-radius: 6px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3391ff;
}

QPushButton:pressed {
    background-color: #2a7de1;
}</string>
